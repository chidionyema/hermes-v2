# Copy to .env and fill in. `./install` does this for you.
# .env is mode 600 and gitignored. Never commit it.

# ---- required ----------------------------------------------------------
# The only key the agent cannot run without.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- strongly recommended ----------------------------------------------
# Lets the agent read issues and open pull requests.
# `gh auth token` prints one if you already use the GitHub CLI.
# For the read-only WATCH lane, use a fine-grained token with
# Contents:read, Issues:write, Pull requests:read, Actions:read and nothing else.
GITHUB_TOKEN=

# ---- optional: talk to it from your phone ------------------------------
# Create a bot with @BotFather, then send it a message and read your own id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_HOME_CHANNEL=

# ---- optional: other providers -----------------------------------------
# Only needed if you change models: in estate.yaml to a non-Anthropic model.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- optional: a second opinion (§16) ----------------------------------
# The consult service runs outside this repo, on a machine that holds the
# credential for whatever second model you have. Leave these empty and every
# `bin/consult` call exits 3, which is the same path a sleeping laptop takes.
# The token is created by the service, mode 600, and is read from
# ~/.claude/consult-token when CONSULT_TOKEN is empty.
CONSULT_URL=
CONSULT_TOKEN=
