#!/usr/bin/env python3
"""Turn a screenshot the founder sends into a GitHub issue.

He photographs a broken screen and sends three words. This turns that into an
issue an agent can pick up tomorrow without asking him anything.

The failure paths are the point of this file, not the happy path:
  - no token, or a token that has expired
  - a file that is not an image, or is not there at all
  - an image too large for the API
  - GitHub returning 500, or rate-limiting us
  - a caption that is empty, or is 4000 characters of pasted log

Run:  python3 handlers/screenshot_to_issue.py <image> [caption] [--dry-run]
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass
from typing import Callable

REPO = "{{ github.slug }}"
API = "https://api.github.com"
MAX_BYTES = 8 * 1024 * 1024          # GitHub rejects larger; fail before the call
MAX_CAPTION = 2000
RETRY_ON = {429, 500, 502, 503, 504}
MAX_ATTEMPTS = 4

# The first bytes of the formats a phone actually produces.
MAGIC = {
    b"\x89PNG\r\n\x1a\n": "png",
    b"\xff\xd8\xff": "jpeg",
    b"GIF87a": "gif",
    b"GIF89a": "gif",
    b"RIFF": "webp",
    b"\x00\x00\x00\x18ftypheic": "heic",
    b"\x00\x00\x00\x1cftypheic": "heic",
}


class HandlerError(Exception):
    """Something we can explain to the founder in one line."""


@dataclass
class Result:
    number: int | None
    url: str | None
    attempts: int
    dry_run: bool = False


def sniff_image(data: bytes) -> str:
    """Return the format, or raise. Never trust the file extension."""
    for magic, name in MAGIC.items():
        if data.startswith(magic):
            return name
    # HEIC and friends put ftyp at offset 4.
    if len(data) > 12 and data[4:8] == b"ftyp":
        return "heif"
    raise HandlerError("that file is not an image I recognise - check what was sent")


def read_image(path: str) -> tuple[bytes, str]:
    p = pathlib.Path(path).expanduser()
    if not p.exists():
        raise HandlerError(f"no file at {p}")
    if p.is_dir():
        raise HandlerError(f"{p} is a directory, not an image")
    data = p.read_bytes()
    if not data:
        raise HandlerError(f"{p} is empty - the transfer probably failed")
    if len(data) > MAX_BYTES:
        raise HandlerError(
            f"{p} is {len(data) // 1024}KB, over the {MAX_BYTES // 1024}KB limit - resize it first"
        )
    return data, sniff_image(data)


def clean_caption(caption: str | None) -> str:
    """A caption is a hint, never a command. Truncate it and never execute it."""
    text = (caption or "").strip()
    if not text:
        return "(no caption)"
    if len(text) > MAX_CAPTION:
        text = text[:MAX_CAPTION] + f"\n\n[truncated, {len(caption or '')} chars sent]"
    # Backticks in a caption would break out of the code fence we put it in.
    return text.replace("```", "'''")


def token() -> str:
    tok = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if not tok:
        raise HandlerError(
            "GITHUB_TOKEN is not set. This handler cannot file anything without it."
        )
    if len(tok) < 20:
        raise HandlerError("GITHUB_TOKEN is set but too short to be a real token")
    return tok


def build_body(image_path: str, fmt: str, caption: str) -> str:
    return (
        "## From a screenshot\n\n"
        f"Sent by the founder. Image: `{pathlib.Path(image_path).name}` ({fmt}).\n\n"
        "His words:\n\n"
        f"```\n{caption}\n```\n\n"
        "## What I read on the screen\n\n"
        "_(fill this in from the image - verbatim, and write `unreadable` where it is)_\n\n"
        "## Where this likely lives\n\n"
        "_(file:line, or 'not found in the repo')_\n\n"
        "## Unknown\n\n"
        "_(the one question that would unblock this)_\n\n"
        "---\nFiled automatically. Not labelled `agent-go` - a screenshot is a "
        "report, not an instruction.\n"
    )


def _default_post(url: str, payload: dict, tok: str) -> tuple[int, dict, dict]:
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={
            "Authorization": f"Bearer {tok}",
            "Accept": "application/vnd.github+json",
            "Content-Type": "application/json",
            "User-Agent": "hermes-screenshot-to-issue",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, json.loads(r.read() or b"{}"), dict(r.headers)
    except urllib.error.HTTPError as e:
        raw = e.read() or b"{}"
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError:
            parsed = {"message": raw.decode("utf-8", "replace")[:200]}
        return e.code, parsed, dict(e.headers or {})
    except urllib.error.URLError as e:
        raise HandlerError(f"could not reach GitHub: {e.reason}") from e


def create_issue(
    title: str,
    body: str,
    post: Callable[[str, dict, str], tuple[int, dict, dict]] = _default_post,
    sleeper: Callable[[float], None] = time.sleep,
    tok: str | None = None,
) -> Result:
    """POST the issue. Retry only what is worth retrying."""
    tok = tok or token()
    payload = {"title": title[:250], "body": body, "labels": ["triage"]}
    url = f"{API}/repos/{REPO}/issues"

    for attempt in range(1, MAX_ATTEMPTS + 1):
        status, data, headers = post(url, payload, tok)

        if status in (200, 201):
            return Result(data.get("number"), data.get("html_url"), attempt)

        if status in (401, 403) and "rate limit" not in str(data.get("message", "")).lower():
            raise HandlerError(
                f"GitHub refused the token ({status}: {data.get('message')}). "
                "Run `gh auth status` and check the token has repo scope."
            )

        if status not in RETRY_ON:
            # 404 means the repo or the scope is wrong. 422 means our payload is
            # wrong. Retrying either just repeats the same mistake.
            raise HandlerError(f"GitHub said {status}: {data.get('message', data)}")

        if attempt == MAX_ATTEMPTS:
            raise HandlerError(
                f"GitHub returned {status} on all {MAX_ATTEMPTS} attempts. Not filed."
            )

        retry_after = headers.get("Retry-After") or headers.get("retry-after")
        wait = float(retry_after) if retry_after else 2.0 ** (attempt - 1)
        sleeper(min(wait, 60.0))

    raise HandlerError("unreachable")


def handle(image_path: str, caption: str | None, dry_run: bool = False, **kw) -> Result:
    data, fmt = read_image(image_path)
    text = clean_caption(caption)
    first_line = text.splitlines()[0][:80] if text != "(no caption)" else "screenshot from the founder"
    title = first_line if len(first_line) > 8 else f"Screenshot: {first_line}"
    body = build_body(image_path, fmt, text)
    if dry_run:
        print(f"TITLE: {title}\n\n{body}")
        return Result(None, None, 0, dry_run=True)
    return create_issue(title, body, **kw)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("image")
    ap.add_argument("caption", nargs="?", default="")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args(argv)
    try:
        r = handle(a.image, a.caption, a.dry_run)
    except HandlerError as e:
        print(f"Not filed: {e}", file=sys.stderr)
        return 1
    if r.dry_run:
        return 0
    print(f"Filed #{r.number} in {r.attempts} attempt(s): {r.url}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
