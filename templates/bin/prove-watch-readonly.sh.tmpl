#!/usr/bin/env bash
# Prove WATCH cannot write code. The proof is a write that fails, not a claim
# that it would. Spec §5. Run this once the founder has minted the PAT.
set -uo pipefail
H="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$H/profiles/watch/READONLY_PROOF.txt"
TOK="${GITHUB_TOKEN_WATCH:-}"
if [ -z "$TOK" ]; then
  echo "GITHUB_TOKEN_WATCH is not set. Nothing to prove yet." >&2
  exit 1
fi
{
  echo "WATCH read-only proof - $(date -u +%Y-%m-%dT%H:%MZ)"
  echo
  echo "## It can read"
  echo "\$ gh api repos/{{ github.slug }} --jq .full_name"
  GH_TOKEN="$TOK" gh api repos/{{ github.slug }} --jq .full_name 2>&1
  echo
  echo "## It can open an issue - that is its job"
  echo "\$ gh api repos/{{ github.slug }}/issues -X GET --jq 'length'"
  GH_TOKEN="$TOK" gh api repos/{{ github.slug }}/issues -X GET --jq 'length' 2>&1
  echo
  echo "## It cannot write code - this must fail"
  echo "\$ gh api -X PUT repos/{{ github.slug }}/contents/.watch-write-test"
  GH_TOKEN="$TOK" gh api -X PUT repos/{{ github.slug }}/contents/.watch-write-test \
    -f message=probe -f content=cHJvYmU= 2>&1 | head -3
  echo
  echo "## It cannot merge - this must fail too"
  echo "\$ gh api -X PUT repos/{{ github.slug }}/pulls/1/merge"
  GH_TOKEN="$TOK" gh api -X PUT repos/{{ github.slug }}/pulls/1/merge 2>&1 | head -3
  echo
  echo "A pass here means the last two commands were refused. If either"
  echo "succeeded, WATCH is not read-only and this file is the evidence of that."
} > "$OUT"
cat "$OUT"
