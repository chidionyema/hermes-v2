 hermes_state.py                               |  11 +-
 tests/gateway/test_clarify_answer_receipt.py  | 116 ++++++++++++++++++
 .../test_append_message_active_flag.py        |  62 ++++++++++
 4 files changed, 261 insertions(+), 1 deletion(-)
 create mode 100644 tests/gateway/test_clarify_answer_receipt.py
