#!/usr/bin/env bash
# Prove the install works. One command, one table, one exit code.
#
#   bin/verify          the fast checks, a few seconds
#   bin/verify --full   also run every acceptance command in REQUIREMENTS.jsonl
#
# Every line is a command and its real output. Nothing here is an assertion.
set -uo pipefail

H="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$H"
export HERMES_HOME="$H"

PASS=0; FAIL=0
row() {  # row <name> <exit-code> <detail>
  if [ "$2" = 0 ]; then PASS=$((PASS+1)); printf '  \033[32mPASS\033[0m  %-34s %s\n' "$1" "${3:-}"
  else               FAIL=$((FAIL+1)); printf '  \033[31mFAIL\033[0m  %-34s %s\n' "$1" "${3:-}"; fi
}

PY=python3; [ -x .venv/bin/python ] && PY=.venv/bin/python

printf '\n\033[1mVerifying %s\033[0m\n\n' "$H"

# 1. the estate file is readable and complete
D="$("$PY" -c "
import yaml,sys
d=yaml.safe_load(open('estate.yaml'))
print(d['estate']['name'], len(d['services']))
" 2>&1)"
row "estate.yaml describes an estate" "$?" "$D"

# 2. no generated file has drifted from its template
OUT="$("$PY" bin/render --check 2>&1 | tail -1)"
row "generated files match templates" "$?" "$OUT"

# 3. the agent runs, and it is the pinned build
V="$(./bin/hermes --version 2>/dev/null | grep -o 'Hermes Agent v[0-9.]*' | head -1)"
[ -n "$V" ]; row "the agent runs" "$?" "$V"

SHA_WANT="$(sed -n 2p PINNED_VERSION)"
SHA_HAVE="$(git -C hermes-agent rev-parse HEAD 2>/dev/null)"
[ "$SHA_WANT" = "$SHA_HAVE" ]
row "agent is the pinned commit" "$?" "${SHA_HAVE:0:10} (want ${SHA_WANT:0:10})"

# 4. it points at this home, not some other estate
HOME_SEEN="$(./bin/hermes --version 2>/dev/null | sed -n 's/^Install directory: //p')"
case "$HOME_SEEN" in "$H"*) true ;; *) false ;; esac
row "agent home is this directory" "$?" "${HOME_SEEN:-unknown}"

# 5. every model configured is one we can price
OUT="$("$PY" bin/check-models-priced.py 2>&1 | tail -1)"
row "every model has a price" "$?" "$OUT"

# 6. a usable Anthropic credential exists, from either of the two places it
#    can live: .env, or the agent's own credential pool after `hermes auth`.
CRED=""
if [ -f .env ] && grep -q '^ANTHROPIC_API_KEY=.\+' .env; then CRED=".env"; fi
if [ -z "$CRED" ] && [ -f auth.json ]; then
  "$PY" -c "
import json,sys
p=json.load(open('auth.json')).get('credential_pool',{})
sys.exit(0 if p.get('anthropic') else 1)" 2>/dev/null && CRED="auth.json (hermes auth login)"
fi
# Neither route configured is not a failure on a fresh install. It is the one
# step left, and it is stated rather than hidden, the same as the gateway row.
if [ -n "$CRED" ]; then
  row "an Anthropic credential exists" 0 "$CRED"
else
  printf '  \033[33mTODO\033[0m  %-34s %s\n' "no model credential yet" \
    "./bin/hermes auth login, or put a key in .env"
fi

if [ -f .env ]; then
  MODE="$(stat -f '%Lp' .env 2>/dev/null || stat -c '%a' .env 2>/dev/null)"
  [ "$MODE" = 600 ]; row ".env is private (mode 600)" "$?" "mode $MODE"
fi

# 7. no secret is tracked in git
! git ls-files --error-unmatch .env auth.json >/dev/null 2>&1
row "no secrets tracked in git" "$?" ""

# 8. every service answers
"$PY" - <<'PY'
import subprocess, sys, yaml
d = yaml.safe_load(open('estate.yaml'))
bad = []
for s in d['services']:
    code = subprocess.run(
        ['curl','-s','-o','/dev/null','-w','%{http_code}','--max-time','12', s['url']],
        capture_output=True, text=True).stdout.strip()
    alive = code[:1] in ('2','3') or code in ('401','403','404')
    print(f"        {s['key']:<12} {code:<5} {'answering' if alive else 'NOT ANSWERING'}  {s['url']}")
    if not alive:
        bad.append(s['key'])
sys.exit(1 if bad else 0)
PY
row "every service answers" "$?" ""

# 9. the schedule exists
JOBS="$(./bin/hermes cron list 2>/dev/null | grep -cE '^  [0-9a-f]{12} \[')"
[ "${JOBS:-0}" -gt 0 ]; row "cron jobs installed" "$?" "${JOBS:-0} jobs"

# 10. is anything actually running?
if ./bin/hermes cron list 2>&1 | grep -q "Gateway is not running"; then
  printf '  \033[33mIDLE\033[0m  %-34s %s\n' "the gateway is not running" "start it: ./bin/hermes gateway install"
else
  row "the gateway is running" 0 "jobs fire on schedule"
fi

# --full: the whole requirement ledger, which is slower
if [ "${1:-}" = "--full" ]; then
  printf '\n'
  "$PY" bin/check-requirements.py 2>&1 | grep -E '^(PASS [0-9]+|TIMED OUT)' | sed 's/^/  /'
fi

printf '\n  %d passed, %d failed\n\n' "$PASS" "$FAIL"
[ "$FAIL" = 0 ]
