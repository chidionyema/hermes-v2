#!/usr/bin/env bash
# Prove the install works. One command, one table, one exit code.
#
#   bin/verify          the fast checks, a few seconds
#   bin/verify --full   also run every acceptance command in REQUIREMENTS.jsonl
#
# Every line is a command and its real output. Nothing here is an assertion.
set -uo pipefail

H="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$H"
export HERMES_HOME="$H"

PASS=0; FAIL=0
row() {  # row <name> <exit-code> <detail>
  if [ "$2" = 0 ]; then PASS=$((PASS+1)); printf '  \033[32mPASS\033[0m  %-34s %s\n' "$1" "${3:-}"
  else               FAIL=$((FAIL+1)); printf '  \033[31mFAIL\033[0m  %-34s %s\n' "$1" "${3:-}"; fi
}

PY=python3; [ -x .venv/bin/python ] && PY=.venv/bin/python

printf '\n\033[1mVerifying %s\033[0m\n\n' "$H"

# 1. the estate file is readable and complete
D="$("$PY" -c "
import yaml,sys
d=yaml.safe_load(open('estate.yaml'))
print(d['estate']['name'], len(d['services']))
" 2>&1)"
row "estate.yaml describes an estate" "$?" "$D"

# 2. no generated file has drifted from its template
RAW="$("$PY" bin/render --check 2>&1)"; RC=$?
if [ $RC = 0 ]; then OUT="$(echo "$RAW" | grep -o '[0-9]* checked')"
else OUT="$(echo "$RAW" | sed -n '2,4p' | tr -s ' \n' ' ')"; fi
row "generated files match templates" "$RC" "$OUT"

# 2b. and the README still describes what the repo ships. A README rots without
# anything failing, which is the same failure mode as a health check that
# watches nothing. This checks the two parts a machine can know: the list of
# generated files, and every cron job's name and schedule.
RAW="$("$PY" bin/check-readme.py 2>&1)"; RC=$?
OUT="$(printf '%s' "$RAW" | head -2 | tail -1 | sed 's/^ *//')"
[ "$RC" = 0 ] && OUT="$(printf '%s' "$RAW" | sed -n 's/^PASS README describes.*(\(.*\))$/\1/p')"
row "README describes what ships" "$RC" "$OUT"

# 3. the agent runs, and it is the pinned build
V="$(./bin/hermes --version 2>/dev/null | grep -o 'Hermes Agent v[0-9.]*' | head -1)"
[ -n "$V" ]; row "the agent runs" "$?" "$V"

SHA_WANT="$(sed -n 2p PINNED_VERSION)"
SHA_HAVE="$(git -C hermes-agent rev-parse HEAD 2>/dev/null)"
[ "$SHA_WANT" = "$SHA_HAVE" ]
row "agent is the pinned commit" "$?" "${SHA_HAVE:0:10} (want ${SHA_WANT:0:10})"

# 3b. the python bound install enforces still matches what the agent demands.
#     These drift silently: the agent bumps its ceiling, install keeps picking
#     an interpreter pip then refuses. It cost one clean install to find.
WANT="$(grep -m1 '^requires-python' hermes-agent/pyproject.toml 2>/dev/null | tr -d ' "')"
HAVE_MIN="$(grep -m1 '^PYTHON_MIN=' install | cut -d'"' -f2)"
HAVE_MAX="$(grep -m1 '^PYTHON_MAX_EXCL=' install | cut -d'"' -f2)"
case "$WANT" in
  *">=$HAVE_MIN,<$HAVE_MAX"*) RC=0 ;;
  "")                         RC=0; WANT="agent not installed, nothing to compare" ;;
  *)                          RC=1 ;;
esac
row "install and agent agree on python" "$RC" "install: >=$HAVE_MIN,<$HAVE_MAX  agent: ${WANT#requires-python=}"

VENV_V="$(.venv/bin/python -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null)"
[ -n "$VENV_V" ]
row "the venv python is in range" "$?" "${VENV_V:-no venv}"

# 4. it points at this home, not some other estate
HOME_SEEN="$(./bin/hermes --version 2>/dev/null | sed -n 's/^Install directory: //p')"
case "$HOME_SEEN" in "$H"*) true ;; *) false ;; esac
row "agent home is this directory" "$?" "${HOME_SEEN:-unknown}"

# 5. every model configured is one we can price
OUT="$("$PY" bin/check-models-priced.py 2>&1 | tail -1 | cut -c1-40)"
row "every model has a price" "$?" "$OUT"

# 6. a usable Anthropic credential exists, from either of the two places it
#    can live: .env, or the agent's own credential pool after `hermes auth`.
CRED=""
if [ -f .env ] && grep -q '^ANTHROPIC_API_KEY=.\+' .env; then CRED=".env"; fi
if [ -z "$CRED" ] && [ -f auth.json ]; then
  "$PY" -c "
import json,sys
p=json.load(open('auth.json')).get('credential_pool',{})
sys.exit(0 if p.get('anthropic') else 1)" 2>/dev/null && CRED="auth.json (hermes auth login)"
fi
# Neither route configured is not a failure on a fresh install. It is the one
# step left, and it is stated rather than hidden, the same as the gateway row.
if [ -n "$CRED" ]; then
  row "an Anthropic credential exists" 0 "$CRED"
else
  printf '  \033[33mTODO\033[0m  %-34s %s\n' "no model credential yet" \
    "./bin/hermes auth login, or put a key in .env"
fi

if [ -f .env ]; then
  MODE="$(stat -f '%Lp' .env 2>/dev/null || stat -c '%a' .env 2>/dev/null)"
  [ "$MODE" = 600 ]; row ".env is private (mode 600)" "$?" "mode $MODE"
fi

# 7. no secret is tracked in git
! git ls-files --error-unmatch .env auth.json >/dev/null 2>&1
row "no secrets tracked in git" "$?" ""

# 8. every service answers
"$PY" - <<'PY'
import subprocess, sys, yaml
d = yaml.safe_load(open('estate.yaml'))
bad = []
for s in d['services']:
    code = subprocess.run(
        ['curl','-s','-o','/dev/null','-w','%{http_code}','--max-time','12', s['url']],
        capture_output=True, text=True).stdout.strip()
    answering = code[:1] in ('2','3') or code in ('401','403','404')
    # expect: stopped means the founder turned it off. Silence is the pass and
    # an answer is the fault, because a machine that woke up is spending money
    # nobody authorised.
    if s.get('expect') == 'stopped':
        ok = not answering
        said = 'stopped, as ordered' if ok else 'AWAKE, AND SHOULD NOT BE'
    else:
        ok = answering
        said = 'answering' if ok else 'NOT ANSWERING'
    print(f"        {s['key']:<12} {code:<5} {said}  {s['url']}")
    if not ok:
        bad.append(s['key'])
sys.exit(1 if bad else 0)
PY
row "every service is as ordered" "$?" ""

# 8b. no service lives on a platform the estate has left
# 2026-08-26: estate.yaml still probed three fly.dev hosts two days after R1.
# The rows above were green ("stopped, as ordered") because a dead host is
# silent. This reads the file against the ruling instead of the network.
OUT="$("$PY" bin/check-platform.py estate.yaml 2>&1)"; RC=$?
row "no service on a platform we left" "$RC" "$(echo "$OUT" | head -1)"

# 8c. the URL card on his phone is the current one
# crew#282: every UI's URL pinned in Telegram. state/urls-pin.json holds the
# pinned message id and the hash of what was pinned; this rebuilds the card
# from the catalogue and fails when the pin is missing or behind.
if [ -f state/urls-pin.json ] && grep -q '^urls:' estate.yaml; then
  WANT="$("$PY" scripts/estate-urls.py --dry-run 2>/dev/null | shasum -a 256 | cut -c1-64)"
  HAVE="$("$PY" -c 'import json;print(json.load(open("state/urls-pin.json"))["hash"])' 2>/dev/null)"
  N="$("$PY" -c 'import json;print(json.load(open("state/urls-pin.json"))["n"])' 2>/dev/null)"
  [ -n "$WANT" ] && [ "$WANT" = "$HAVE" ]
  row "the URL card is pinned and current" "$?" "$N links, pinned msg $("$PY" -c 'import json;print(json.load(open("state/urls-pin.json"))["message_id"])' 2>/dev/null)"
elif grep -q '^urls:' estate.yaml; then
  row "the URL card is pinned and current" 1 "nothing pinned yet: run scripts/estate-urls.py"
fi

# 9. the schedule exists
JOBS="$(./bin/hermes cron list 2>/dev/null | grep -cE '^  [0-9a-f]{12} \[')"
[ "${JOBS:-0}" -gt 0 ]; row "cron jobs installed" "$?" "${JOBS:-0} jobs"

# 10. is anything actually running?
# Ask the scheduler, not `cron list`. Reading it off cron list was wrong: with
# no jobs installed that command prints no warning at all, and the absence of a
# warning was reported as "the gateway is running - jobs fire on schedule".
# `cron status` answers the question that matters, which is whether the ticker
# is alive, not whether a process exists.
CRON_STATUS="$(./bin/hermes cron status 2>&1)"
case "$CRON_STATUS" in
  *"cron jobs will fire automatically"*)
    row "the gateway is running" 0 "cron ticker alive" ;;
  *STALLED*)
    row "the cron ticker is stalled" 1 "gateway up, jobs not firing: ./bin/hermes gateway restart" ;;
  *)
    printf '  \033[33mIDLE\033[0m  %-34s %s\n' "the gateway is not running" "start it: ./bin/hermes gateway install" ;;
esac

# 11. can the agent actually reach the founder?
# The rows above prove the gateway runs. None of them proves a word of it ever
# reaches his phone. Every job shipped with deliver=local, which writes a file
# in cron/output/ and tells nobody -- a scheduler talking to itself. This row
# fails if any job goes back to local.
LOCAL="$("$PY" - <<'PYEOF'
import json
d = json.load(open('cron/jobs.json'))
jobs = d if isinstance(d, list) else d.get('jobs', d)
if isinstance(jobs, dict): jobs = list(jobs.values())
bad = [j.get('name') for j in jobs if j.get('deliver') in (None, '', 'local')]
print(','.join(bad) if bad else '')
PYEOF
)"
if [ -z "$LOCAL" ]; then
  row "every job reaches the founder" 0 "all jobs deliver off-machine"
else
  row "every job reaches the founder" 1 "delivers to nobody: $LOCAL"
fi

# 12. is launchd running the plist that is on disk?
# launchctl runs the definition it loaded at bootstrap, not the file. Edit the
# plist without a bootout/bootstrap and the job keeps running the old one,
# reports last-exit 0, and does nothing you asked for. A peer found eleven jobs
# in that state today. This compares the loaded ProgramArguments against the
# file and fails when they have drifted apart.
LABEL="ai.architect.gateway"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
if [ ! -f "$PLIST" ]; then
  row "launchd runs the plist on disk" 1 "no plist at $PLIST"
elif ! launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
  row "launchd runs the plist on disk" 1 "$LABEL is not loaded"
else
  ON_DISK="$("$PY" -c 'import plistlib,sys
print(chr(10).join(plistlib.load(open(sys.argv[1],"rb"))["ProgramArguments"]))' "$PLIST" 2>/dev/null)"
  LOADED="$(launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null \
    | awk '/arguments = \{/{f=1;next} f&&/^[[:space:]]*\}/{exit} f' \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if [ "$ON_DISK" = "$LOADED" ]; then
    row "launchd runs the plist on disk" 0 "loaded definition matches the file"
  else
    row "launchd runs the plist on disk" 1 "loaded definition has drifted from $PLIST"
  fi
fi

# 13. does the agent get all of the laws, or only some of them?
# Twice now the laws file has grown past the cap and the prompt builder has
# quietly thrown the middle away: 2026-08-23 21:47 lost the bodies of LAW 12
# to LAW 30, and 2026-08-24 02:30 lost the back of LAW 34 and all of LAWS 35
# to 40. Both times the only trace was one WARNING line in logs/errors.log,
# and both times an agent bumped the number instead of noticing it recurs.
# The laws grew 26,162 chars in one day, so the number will fall behind again.
#
# This does not compare numbers. It runs the real truncator over the real file
# and fails if a single character was dropped, which is the artifact and not a
# proxy for it. When it goes red the fix is to raise context_file_max_chars in
# config.yaml until this passes -- the detail line says by how much.
LAWS="$("$PY" - <<'PYEOF' 2>&1
import logging
import sys
sys.path.insert(0, "hermes-agent")
from pathlib import Path
from agent.prompt_builder import _get_context_file_max_chars, _truncate_content

# The truncator logs its own WARNING, and row() prints the first line of what
# it captures. Left on, that line is what the founder sees instead of the one
# telling him what number to set.
logging.disable(logging.CRITICAL)

src = None
for p in (Path.home() / "AGENTS.md", Path("AGENTS.md"), Path("CLAUDE.md")):
    if p.is_file():
        src = p
        break
if src is None:
    print("no laws file found")
    raise SystemExit(1)

text = src.read_text(encoding="utf-8", errors="replace")
cap = _get_context_file_max_chars(200000)
kept = _truncate_content(text, src.name, context_length=200000)
if len(kept) == len(text):
    print(f"{src.name} {len(text)} chars, whole, cap {cap}")
    raise SystemExit(0)
# head 70% + tail 20% is what survives, so the cap has to clear size / 0.9
need = int(len(text) / 0.9) + 1
print(
    f"{src.name} is {len(text)} chars, cap {cap}, "
    f"{len(text) - len(kept)} dropped from the middle -- "
    f"set context_file_max_chars to at least {need}"
)
raise SystemExit(1)
PYEOF
)"; RC=$?
row "the agent gets every law" "$RC" "$LAWS"

# 9. dispatch (crew#182 CP7): the drill proves both ways in one run - an
# agent-go issue is claimed into a worktree, branch and run; icebox never is.
# Then the runtime the config names must actually be on this machine, or a
# claimed issue would sit with no session behind it.
OUT="$("$PY" -m pytest tests/test_incident_crew182_cp7_dispatch.py -q 2>&1 | tail -1)"; RC=$?
row "dispatch claims agent-go and never icebox" "$RC" "$OUT"
RT="$("$PY" - <<'PYEOF'
import yaml; e = yaml.safe_load(open("estate.yaml")) or {}
d = e.get("dispatch") or {}; print(((d.get("runtimes") or {}).get(d.get("runtime", "claude")) or [d.get("runtime", "claude")])[0])
PYEOF
)"
command -v "$RT" >/dev/null 2>&1; row "the dispatch runtime is installed" "$?" "$RT"

# --full: the whole requirement ledger, which is slower
if [ "${1:-}" = "--full" ]; then
  printf '\n'
  "$PY" bin/check-requirements.py 2>&1 | grep -E '^(PASS [0-9]+|TIMED OUT)' | sed 's/^/  /'
fi

printf '\n  %d passed, %d failed\n\n' "$PASS" "$FAIL"
[ "$FAIL" = 0 ]
