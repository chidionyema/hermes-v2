#!/usr/bin/env python3
"""Ask another model a question, from inside a lane, without waking anyone.

An agent that is stuck has two bad options: guess, or stop and wait for the
founder. This is the third. It sends the question to the estate's model router
(one endpoint, every lane behind it, crew#568) and the lane carries on.

  bin/consult "why does kubectl rollout status hang after a deploy?"
  bin/consult --health
  bin/consult --json "..."        the whole response object, for a script

  exit 0   answered; the answer is on stdout
  exit 3   no consult available -- this is normal, take the fallback path
  exit 1   the question was malformed

EXIT 3 IS NOT AN ERROR. The router lives in the estate and the laptop may be
off the network. A lane that treats an unavailable consult as a failure will
page a person over a convenience. When you get 3, do what §16 says: write the
question into the issue as a comment and carry on with what you can still do.

CONFIGURATION. Environment only, none required:

  LITELLM_BASE_URL   default https://llm.<ESTATE_ZONE>/v1 (ESTATE_ZONE: the estate zone, one value in idp clusters/<cluster>/estate-config.yaml)
  LITELLM_API_KEY    else the file ~/.config/prospector/secrets.d/LITELLM_API_KEY
  CONSULT_LANE       default minimax (a row of the router's model list)
  CONSULT_TIMEOUT    seconds, default 120
"""

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

BASE = (os.environ.get("LITELLM_BASE_URL") or f"https://llm.{os.environ['ESTATE_ZONE']}/v1").rstrip("/")
LANE = os.environ.get("CONSULT_LANE", "minimax")
TIMEOUT = int(os.environ.get("CONSULT_TIMEOUT", "120"))
UNAVAILABLE = 3


def key() -> str:
    k = os.environ.get("LITELLM_API_KEY", "").strip()
    if k:
        return k
    try:
        return (
            (Path.home() / ".config/prospector/secrets.d/LITELLM_API_KEY")
            .read_text()
            .strip()
        )
    except OSError:
        return ""


def call(
    path: str, payload: dict | None = None, timeout: int = TIMEOUT
) -> tuple[bool, dict]:
    """Return (ok, object). Never raises, never blocks past the timeout, never prints the key."""
    k = key()
    if not k:
        return False, {"error": "no LITELLM_API_KEY in the environment or secrets.d"}
    data = json.dumps(payload).encode() if payload is not None else None
    base = BASE if path.startswith("/chat") else BASE.rsplit("/v1", 1)[0]
    req = urllib.request.Request(  # noqa: S310 - https only, base is fixed
        f"{base}{path}",
        data=data,
        headers={"Authorization": f"Bearer {k}", "Content-Type": "application/json"},
        method="POST" if data else "GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:  # noqa: S310
            return True, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return False, json.loads(e.read() or b"{}")
        except Exception:  # noqa: BLE001
            return False, {"error": f"HTTP {e.code}"}
    except Exception as e:  # noqa: BLE001
        return False, {"error": f"{type(e).__name__}: {e}"}


def main(argv: list[str]) -> int:
    want_json = "--json" in argv
    argv = [a for a in argv if a != "--json"]
    if "--health" in argv:
        ok, _ = call("/health/liveliness", timeout=15)
        print(f"consult: {'ok' if ok else 'unavailable'} ({BASE}, lane={LANE})")
        return 0 if ok else UNAVAILABLE
    question = " ".join(a for a in argv if not a.startswith("--")).strip()
    if not question:
        print(__doc__, file=sys.stderr)
        return 1
    ok, body = call(
        "/chat/completions",
        {
            "model": LANE,
            "max_tokens": 2000,
            "messages": [{"role": "user", "content": question}],
        },
    )
    answer = (
        ((body.get("choices") or [{}])[0].get("message") or {}).get("content", "")
        if ok
        else ""
    )
    if want_json:
        print(json.dumps(body, indent=2))
    if ok and answer.strip():
        if not want_json:
            print(answer.strip())
        return 0
    if not want_json:
        print(f"consult unavailable: {body.get('error') or body}", file=sys.stderr)
    return UNAVAILABLE


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
