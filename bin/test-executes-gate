#!/usr/bin/env bash
# A test that executes nothing is not a test.
#
# idp deleted 322 of these on 2026-09-04 (519d59e8) and 169 more on 2026-09-05 (02d0abe8), and
# `bin/test-executes-gate` there has refused new ones since. This repository was never swept, so
# nine files survived here doing the same thing: open this repository's own config.yaml, Dockerfile
# or plugin.yaml, and assert what it says. The file read and the expectation held are the same
# statement written twice, so none of them could catch a defect -- what they caught was a
# deliberate decision, at the cost of a red run every time one was made.
#
# Founder, 2026-09-05: "this incident test thing is a farce", "its basically patching and
# firefighting", "fix problems at root cause level and batch once and for all", "i dont want any of
# that in this estate".
#
# It grades behaviour, not wording: does this file start a process, open a socket, make a request,
# or load a module of this repository and call it. An existing file is never graded -- only what a
# change adds (LAW 45: the guard, not the note).
#
# It also refuses the NAME. A file called test_incident_<date-or-ticket> is a note about one
# instance, and the naming convention is what reproduces the practice: a session reads the
# directory, sees the pattern, and writes the next one. A new test names the rule it holds. The
# fourteen that already carry the old name here all run something and are left alone -- the gate
# grades what a change adds, never what exists.
#
# LAW 46: the checkout is computed from this script, never named.
set -euo pipefail
on_exit() {
	local rc=$?
	[ "$rc" -le 1 ] || echo "test-executes-gate stopped early (exit $rc)" >&2
}
trap on_exit EXIT
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BASE="${1:-origin/main}"

# The ways a python test reaches beyond reading a file. `docker` is anchored as an attribute
# access: the bare word matches "Dockerfile", which is a path a reads-only test opens, and idp's
# copy of this gate let a reads-only file through on exactly that.
EXECUTES='subprocess|requests\.|httpx|socket\.|urllib\.request|os\.system|pexpect|docker\.|kubernetes\.client|importlib|spec_from_file'

added=$(cd "$ROOT" && git diff --name-only --diff-filter=A "$BASE...HEAD" -- 'tests/*.py' 2>/dev/null || true)
[ -n "$added" ] || {
	echo "ok    executes  no new test file in this change"
	exit 0
}

bad=0
while IFS= read -r f; do
	[ -n "$f" ] || continue
	if grep -qE "$EXECUTES" "$ROOT/$f"; then
		case "$(basename "$f")" in
		test_incident_*)
			echo "FAIL  executes  $f is named for the day something broke, not for the rule it holds."
			echo "                A file named test_incident_* is a note about one instance; the next"
			echo "                session reads the name and writes the next one. Name the invariant."
			bad=1
			;;
		*) echo "ok    executes  $f runs something" ;;
		esac
	else
		echo "FAIL  executes  $f asserts this repository's own files back at it and runs nothing."
		echo "                Grade what the value causes -- a loader that reads the file, a request"
		echo "                the gateway answers, a container that boots -- or delete the file."
		bad=1
	fi
done <<<"$added"
exit "$bad"
