#!/usr/bin/env python3
"""Load the sovereign plugin the way the gateway does and print what it registers.

Exit 0 when every command the spec names (crew#284 CP1, kini spec 2.2) and the photo hook are
registered; exit 1 with the missing names otherwise. `bin/verify` reads this as one row.
Usage: verify-sovereign-plugin [plugin-dir]   (default: plugins/sovereign next to this repo)
"""
import importlib.util
import os
import sys

WANT_COMMANDS = ("sb-list", "sb-show", "sb-stop", "sb-approve", "sb-deny", "sb-steer", "sb-undo")
WANT_HOOKS = ("pre_gateway_dispatch",)


class _Ctx:
    def __init__(self):
        self.commands, self.hooks = [], []

    def register_command(self, name, *_a, **_k):
        self.commands.append(name)

    def register_hook(self, name, *_a, **_k):
        self.hooks.append(name)


def registered(plugin_dir: str) -> tuple[list[str], list[str]]:
    init = os.path.join(plugin_dir, "__init__.py")
    spec = importlib.util.spec_from_file_location("sovereign_plugin_under_test", init)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    ctx = _Ctx()
    mod.register(ctx)
    return ctx.commands, ctx.hooks


def main(argv: list[str]) -> int:
    here = os.path.dirname(os.path.abspath(__file__))
    plugin_dir = argv[1] if len(argv) > 1 else os.path.join(here, "..", "plugins", "sovereign")
    try:
        commands, hooks = registered(plugin_dir)
    except Exception as exc:  # a plugin that cannot load registers nothing
        print(f"plugin did not load: {exc}")
        return 1
    missing = [c for c in WANT_COMMANDS if c not in commands] + [h for h in WANT_HOOKS if h not in hooks]
    if missing:
        print("missing: " + " ".join(missing))
        return 1
    print(f"{len(commands)} commands, hook {hooks[0]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
