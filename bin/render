#!/usr/bin/env python3
"""Turn templates/ into working files, using estate.yaml as the only input.

Nothing in this repo should name your services except estate.yaml. Every file
that has to name them lives in templates/ with a placeholder, and this script
fills them in.

  bin/render            write the files
  bin/render --check    do not write; exit 1 if any file on disk has drifted
  bin/render --list     show what would be written

The template language is deliberately tiny. Two forms and no more:

  {{ github.slug }}          one value, dotted path into estate.yaml
  {{#services}}...{{/services}}   repeat the block once per item of that list

Inside a list block the item's own fields are the placeholders: {{app}} for a
service, or {{.}} when the list holds plain strings. Any top-level list in
estate.yaml can be looped over, not just services.

A placeholder with no value is an error, not an empty string. A silent blank in
a health probe is how you get a monitor that watches nothing.

No template may name one particular service. {{ service.engine.app }} would
build fine here and then fail on the next estate, which is exactly the bug
this file exists to prevent, so it is refused.
"""
import os
import re
import sys
from urllib.parse import urlparse

HOME = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TEMPLATES = os.path.join(HOME, "templates")
ESTATE = os.path.join(HOME, "estate.yaml")

try:
    import yaml
except ImportError:
    sys.exit("render: PyYAML is missing. Run ./install, or: pip install pyyaml")


def load_estate():
    if not os.path.exists(ESTATE):
        sys.exit(
            "render: estate.yaml does not exist.\n"
            "        Copy estate.example.yaml to estate.yaml and fill it in,\n"
            "        or run ./install which asks you the questions."
        )
    with open(ESTATE) as f:
        d = yaml.safe_load(f) or {}
    for required in ("estate", "github", "services"):
        if required not in d:
            sys.exit(f"render: estate.yaml has no '{required}:' section")
    if not d["services"]:
        sys.exit("render: estate.yaml lists no services. The pulse would watch nothing.")
    # Derived values, so a template never has to build a string itself.
    d["github"]["slug"] = f"{d['github']['owner']}/{d['github']['repo']}"
    for s in d["services"]:
        for field in ("key", "app", "url"):
            if not s.get(field):
                sys.exit(f"render: a service is missing '{field}:' -> {s}")
        # The host is what an allowlist needs, and it is already in the url.
        # Deriving it means no template has to assume a platform's domain.
        s["host"] = urlparse(s["url"]).netloc
        s.setdefault("expect", "any-answer")
        s.setdefault("note", "")
        # A note reads as a sentence after the facts, or as nothing at all.
        s["note_suffix"] = f" {s['note']}" if s["note"] else ""
    # Hosts this estate reaches that are not one of the probed services.
    # Optional, and empty is the normal answer.
    if not d.get("egress_extra"):
        d["egress_extra"] = []
    return d


def lookup(estate, path):
    """Dotted path into the estate dict. Missing is fatal, never blank."""
    node = estate
    for part in path.split("."):
        if not isinstance(node, dict) or part not in node:
            sys.exit(f"render: estate.yaml has no value for '{{{{ {path} }}}}'")
        node = node[part]
    return str(node)


SECTION = re.compile(r"\{\{#([a-zA-Z0-9_]+)\}\}(.*?)\{\{/\1\}\}", re.S)
# Hyphens are legal in a service key ("store-web"), so they are legal here.
SCALAR = re.compile(r"\{\{\s*([a-zA-Z0-9_.-]+)\s*\}\}")


def field(chunk, name, value):
    """Replace {{name}} and {{ name }} alike, inside a list block."""
    return re.sub(r"\{\{\s*" + re.escape(name) + r"\s*\}\}", lambda _: value, chunk)


def render_text(text, estate):
    def one_list(match):
        name, body = match.group(1), match.group(2)
        items = estate.get(name)
        if items is None:
            sys.exit(f"render: estate.yaml has no list '{name}:' for "
                     f"{{{{#{name}}}}}")
        if not isinstance(items, list):
            sys.exit(f"render: estate.yaml's '{name}:' is not a list, "
                     f"so {{{{#{name}}}}} cannot repeat over it")
        out = []
        for item in items:
            chunk = body
            if isinstance(item, dict):
                for k, v in item.items():
                    chunk = field(chunk, k, str(v))
            else:
                chunk = field(chunk, ".", str(item))
            out.append(chunk)
        return "".join(out)

    text = SECTION.sub(one_list, text)

    def one_value(match):
        path = match.group(1)
        if path.startswith("service."):
            sys.exit(
                f"render: a template asks for '{{{{ {path} }}}}'.\n"
                "        Naming one service hardcodes this estate into a\n"
                "        template, and the next estate will not have that\n"
                "        key. Loop instead: {{#services}} ... {{/services}}."
            )
        return lookup(estate, path)

    text = SCALAR.sub(one_value, text)
    # An empty {{note}} would otherwise leave the line trailing whitespace.
    return "\n".join(line.rstrip() for line in text.split("\n"))


def targets():
    """Every templates/<path>.tmpl maps to <path> at the repo root."""
    for root, _dirs, files in os.walk(TEMPLATES):
        for name in sorted(files):
            if not name.endswith(".tmpl"):
                continue
            src = os.path.join(root, name)
            rel = os.path.relpath(src, TEMPLATES)[: -len(".tmpl")]
            # A .seed template is a starting point the agent then edits. Write
            # it once; never render over what it learned.
            seed = rel.endswith(".seed")
            if seed:
                rel = rel[: -len(".seed")]
            yield src, os.path.join(HOME, rel), rel, seed


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "--write"
    if not os.path.isdir(TEMPLATES):
        sys.exit("render: there is no templates/ directory")
    estate = load_estate()

    drifted, written = [], []
    for src, dest, rel, seed in targets():
        if seed and os.path.exists(dest):
            continue
        with open(src) as f:
            want = render_text(f.read(), estate)
        have = None
        if os.path.exists(dest):
            with open(dest) as f:
                have = f.read()
        if mode == "--list":
            print(f"  {rel}")
            continue
        if have == want:
            continue
        if mode == "--check":
            drifted.append(rel)
            continue
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "w") as f:
            f.write(want)
        if os.access(src, os.X_OK):
            os.chmod(dest, 0o755)
        written.append(rel)

    if mode == "--check":
        if drifted:
            print("DRIFT: these files no longer match templates/ + estate.yaml")
            for rel in drifted:
                print(f"  {rel}")
            print("Run bin/render to fix, or move your edit into templates/.")
            return 1
        print(f"PASS every generated file matches templates/ + estate.yaml "
              f"({sum(1 for _ in targets())} checked)")
        return 0

    if mode == "--list":
        return 0

    if written:
        for rel in written:
            print(f"  wrote {rel}")
    print(f"rendered {sum(1 for _ in targets())} files for estate "
          f"'{estate['estate']['name']}' ({len(written)} changed)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
