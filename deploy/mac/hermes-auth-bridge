#!/bin/bash
# Keep the Fly volume's Claude credential in step with this Mac's Keychain.
#
# The agent is deliberately not in this path. It runs as the founder, on the
# founder's machine, reading the founder's own credential and pushing it to the
# founder's own container. Nothing it prints is a secret: hashes, lengths,
# expiry timestamps and exit codes only, so the log can be handed to anyone
# debugging it — including an agent — without leaking anything.
#
#   hermes-auth-bridge            sync if the credential changed
#   hermes-auth-bridge --force    sync even if it looks unchanged
#   hermes-auth-bridge --status   say what it knows, change nothing
#
# ONE HUMAN STEP, ONCE. Reading a keychain item's VALUE needs the calling binary
# in that item's ACL. The first time /usr/bin/security asks, macOS shows a
# dialog; click "Always Allow" and it is added to the ACL and never asks again,
# including from launchd. Until that click, a launchd run has no GUI session to
# prompt in and simply fails — which is the whole reason this script reports the
# refusal loudly instead of swallowing it.
set -euo pipefail

APP="${HERMES_AUTH_APP:-prospector-hermes-v2}"
SERVICE="Claude Code-credentials"
REMOTE="/data/dot-claude/.credentials.json"
STATE_DIR="$HOME/.local/state/hermes-auth-bridge"
HASH_FILE="$STATE_DIR/last-hash"
LOG="$STATE_DIR/sync.log"
FLY="${FLY_BIN:-/usr/local/bin/fly}"

mkdir -p "$STATE_DIR"
log() { printf '%s %s\n' "$(date -Iseconds)" "$*" >> "$LOG"; printf '%s\n' "$*"; }

notify() {
    /usr/bin/osascript -e "display notification \"$1\" with title \"Hermes auth bridge\"" \
        >/dev/null 2>&1 || true
}

FORCE=0; STATUS=0
for a in "$@"; do
    case "$a" in
        --force)  FORCE=1 ;;
        --status) STATUS=1 ;;
        *) printf 'unknown option: %s\n' "$a" >&2; exit 2 ;;
    esac
done

# ---------------------------------------------------------------- keychain
# Attributes are readable without authorisation; the value is not. Checking for
# the item first is what separates "you never logged in" from "macOS would not
# hand it over", which are the same empty string if you only run -w.
if ! /usr/bin/security find-generic-password -s "$SERVICE" >/dev/null 2>&1; then
    log "ERROR no '$SERVICE' item in the login keychain. Run: claude setup-token"
    notify "No Claude credential. Run: claude setup-token"
    exit 1
fi
MDAT=$(/usr/bin/security find-generic-password -s "$SERVICE" 2>&1 \
       | grep mdat | grep -o '[0-9]\{14\}Z' | head -1)

set +e
CREDS=$(/usr/bin/security find-generic-password -s "$SERVICE" -w 2>"$STATE_DIR/kc.err")
KC_RC=$?
set -e
KC_ERR=$(head -c 300 "$STATE_DIR/kc.err" 2>/dev/null); rm -f "$STATE_DIR/kc.err"

if [ "$KC_RC" -ne 0 ] || [ -z "$CREDS" ]; then
    log "ERROR keychain item exists (mdat=$MDAT) but its value was refused (rc=$KC_RC): ${KC_ERR:-no error text}"
    log "      This is an authorisation prompt, not a missing credential."
    log "      Run this once in Terminal.app and click Always Allow:"
    log "        ~/.local/bin/hermes-auth-bridge --force"
    notify "Keychain refused the value. Run hermes-auth-bridge --force in Terminal and click Always Allow."
    exit 1
fi

HASH=$(printf %s "$CREDS" | shasum -a 256 | cut -c1-16)
# expiresAt is milliseconds since epoch. Logging when it dies is useful and is
# not the secret; the token itself never leaves this variable.
EXPIRES=$(printf %s "$CREDS" | /usr/bin/python3 -c '
import json, sys, datetime
try:
    ms = json.load(sys.stdin).get("claudeAiOauth", {}).get("expiresAt", 0) or 0
    print(datetime.datetime.fromtimestamp(ms/1000, datetime.timezone.utc).isoformat() if ms else "unknown")
except Exception:
    print("unparseable")
' 2>/dev/null || echo unknown)

if [ "$STATUS" = 1 ]; then
    log "STATUS item mdat=$MDAT hash=$HASH expires=$EXPIRES last-synced=$(cat "$HASH_FILE" 2>/dev/null || echo never)"
    exit 0
fi

if [ "$FORCE" = 0 ] && [ -f "$HASH_FILE" ] && [ "$(cat "$HASH_FILE")" = "$HASH" ]; then
    log "INFO unchanged (hash=$HASH expires=$EXPIRES)"
    exit 0
fi

# ------------------------------------------------------------------- push
TMP=$(mktemp -t hermes-cred)
trap 'rm -f "$TMP"' EXIT
printf %s "$CREDS" > "$TMP"
unset CREDS

# /root/.claude must be a symlink onto the volume or a token the container
# refreshes at 3am is lost on the next restart. `ln -sfn` onto a real directory
# silently nests instead of replacing, so a real one is moved aside first.
# sftp `put` also refuses when the destination already exists, hence the rm.
"$FLY" ssh console -a "$APP" -C "/bin/sh -c '
    mkdir -p /data/dot-claude
    if [ -d /root/.claude ] && [ ! -L /root/.claude ]; then
        cp -a /root/.claude/. /data/dot-claude/ 2>/dev/null || true
        rm -rf /root/.claude
    fi
    ln -sfn /data/dot-claude /root/.claude
    rm -f '"$REMOTE"'
'" >/dev/null 2>&1 || { log "ERROR could not prepare $APP:/data/dot-claude"; notify "Bridge could not reach $APP"; exit 1; }

if ! printf 'put %s %s\n' "$TMP" "$REMOTE" | "$FLY" ssh sftp shell -a "$APP" >/dev/null 2>&1; then
    log "ERROR sftp put failed to $APP:$REMOTE"
    notify "Bridge could not write the credential to $APP"
    exit 1
fi
rm -f "$TMP"; trap - EXIT

# Two angles (LAW 15): the upload said it worked, and the container's own
# resolver says it can now produce a token. The second is the one that matters,
# and it prints a length, never a value.
OUT=$("$FLY" ssh console -a "$APP" -C "/opt/hermes-v2/.venv/bin/python -c 'import sys; sys.path.insert(0,\"/opt/hermes-v2/hermes-agent\"); from agent.anthropic_adapter import resolve_anthropic_token as r; t=r(); print(\"RESOLVED\", len(t) if t else 0)'" 2>&1 | tr -d '\r' | grep -o 'RESOLVED [0-9]*' | head -1)
if [ -z "$OUT" ]; then
    log "ERROR wrote $REMOTE but the container still resolves no token"
    notify "Credential written but $APP cannot use it"
    exit 1
fi

printf %s "$HASH" > "$HASH_FILE"
log "OK synced hash=$HASH expires=$EXPIRES container=$OUT"
